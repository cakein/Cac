# Optional: add an OpenAI API key to enable AI wording on top of the behavior engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Managed email-code sign-in. Use the public/publishable key, never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Local development. Change to the exact HTTPS app origin when deploying.
APP_ORIGIN=http://localhost:5173

# Keep false on independent deployments. Enable only behind trusted Sites ingress
# or for the localhost-only mock user supplied by the Vite development plugin.
TRUST_SITES_AUTH=false
